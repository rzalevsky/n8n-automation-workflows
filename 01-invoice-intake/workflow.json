      "parameters": {
        "promptType": "define",
        "text": "=You are an expert data extractor. Extract the following fields from the invoice text and return ONLY a valid JSON object. Do not include any markdown formatting, code blocks (like ```json), or conversational text. Return JUST the raw JSON.  Required JSON structure: \n{\n  \"invoice_number\": \"invoice number here\",\n  \"contractor\": \"seller company name here (e.g. ACME Sp. z o.o.)\",\n  \"amount\": 123.45,\n  \"currency\": \"PLN\",\n  \"due_date\": \"YYYY-MM-DD\"\n}\n\nInvoice text: {{ $json.text }}"
      },
      "id": "dfb78853-276d-4b25-ac55-69f310c757f2",
      "name": "Basic LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        208,
        0
      ]
    },
    {
      "parameters": {
        "model": "qwen2.5-7b-instruct-1m",
        "options": {
          "baseURL": "={{ $env.LLM_BASE_URL }}"
        }
      },
      "id": "7fbc7cf1-be7d-4c75-9a75-4d48dec1255c",
      "name": "Local LLM (LM Studio)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        208,
        208
      ],
      "credentials": {
        "openAiApi": {
          "id": "62nyfgLJSrBndw23",
          "name": "lm-studio"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// The model is told to return raw JSON, but models occasionally wrap it in a\n// markdown fence or prepend a sentence. Strip the fence, then validate.\n//\n// Design decision: this node throws instead of returning a partial object.\n// In accounting data a silently wrong value is far more expensive than a\n// visibly failed run — a failed execution gets noticed, a wrong amount does not.\n\nconst raw = $input.first().json.text ?? '';\nconst cleaned = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\n\nlet invoice;\ntry {\n  invoice = JSON.parse(cleaned);\n} catch (err) {\n  throw new Error(\n    `LLM did not return valid JSON. Raw output:\\n${cleaned.slice(0, 500)}`\n  );\n}\n\nconst required = ['invoice_number', 'contractor', 'amount', 'currency', 'due_date'];\nconst missing = required.filter(\n  (f) => invoice[f] === undefined || invoice[f] === null || invoice[f] === ''\n);\nif (missing.length) {\n  throw new Error(`Extracted invoice is missing required fields: ${missing.join(', ')}`);\n}\n\n// Locale guard: a Polish-trained model may return \"123,45\" instead of 123.45.\ninvoice.amount = Number(String(invoice.amount).replace(',', '.'));\nif (Number.isNaN(invoice.amount)) {\n  throw new Error(`Amount is not numeric: ${JSON.stringify($input.first().json.text)}`);\n}\n\nreturn [{ json: invoice }];\n"
      },
      "id": "18b1b5ad-7259-45e5-ab3f-395526dfd398",
      "name": "Parse & validate JSON",
