# Copy to .env and fill in your own values. .env is git-ignored — never commit it.
#
# Two things happen with this file:
#   1. Docker Compose substitutes ${VAR} in docker-compose.yml at start-up.
#   2. The resulting values become environment variables inside the n8n
#      container, where workflows read them as {{ $env.VAR }}.
# This is why no environment-specific value appears in the workflow JSON.

# --- Workflow configuration ---

# Google Sheet that receives the extracted invoice rows.
# The ID is the part of the sheet URL between /d/ and /edit.
GOOGLE_SHEET_ID=

# Telegram chat that receives notifications. Message your bot, then read the
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Invoices above this amount take the alert branch instead of the routine one.
INVOICE_ALERT_THRESHOLD=500

# Local LLM endpoint — LM Studio, Ollama, or any OpenAI-compatible server.
#   network_mode: host + LLM on this machine   → http://localhost:1234/v1
#   network_mode: host + LLM on another machine → http://<lan-ip>:1234/v1
#   bridge networking + LLM on the host         → http://host.docker.internal:1234/v1
LLM_BASE_URL=http://localhost:1234/v1

# Trello — scenario 2. The credential inside n8n reads the key and token from
# here rather than storing them in n8n's database, so they live in exactly one
# place. Generate them at https://trello.com/power-ups/admin
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_SECRET=

# Trello list that receives the routed request cards.
# Find it via https://api.trello.com/1/boards/<board>/lists?key=<key>&token=<token>
TRELLO_LIST_ID=

# Shared secret guarding the scenario 2 webhook. The Header Auth credential in
# n8n resolves its value from here, and the test commands read the same line, so
# the secret exists in exactly one place. Generate one with:  openssl rand -hex 32
WEBHOOK_SECRET=

# --- Scenario 3: source monitoring ---

# Feeds to watch, comma-separated. Any valid RSS or Atom URL. These four are the
# ones I actually run: local LLM tooling, LLM stories from Hacker News, workflow
# automation, and the Polish IT market.
RSS_FEEDS=https://simonwillison.net/atom/everything/,https://hnrss.org/newest?q=LLM,https://blog.n8n.io/rss/,https://justjoin.it/blog/feed

# What you actually care about. The model drops everything else, so being
# specific here is what keeps the digest short and worth opening.
DIGEST_TOPICS=local LLM deployment; business process automation; RPA and low-code platforms; the Polish IT job market

# Where the digest is sent.
DIGEST_RECIPIENT=

# How far back to look, and a hard cap on articles sent to the model.
DIGEST_WINDOW_HOURS=24
DIGEST_MAX_ITEMS=40

# --- Instance configuration ---

GENERIC_TIMEZONE=Europe/Warsaw
