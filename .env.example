# Copy to .env and fill in your own values. .env is git-ignored — never commit it.
#
# Two things happen with this file:
#   1. Docker Compose substitutes ${VAR} in docker-compose.yml at start-up.
#   2. The resulting values become environment variables inside the n8n
#      container, where workflows read them as {{ $env.VAR }}.
# This is why no environment-specific value appears in the workflow JSON.

# --- Workflow configuration ---

# Google Sheet that receives the extracted invoice rows.
# The ID is the part of the sheet URL between /d/ and /edit.
GOOGLE_SHEET_ID=

# Telegram chat that receives notifications. Message your bot, then read the
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Invoices above this amount take the alert branch instead of the routine one.
INVOICE_ALERT_THRESHOLD=500

# Local LLM endpoint — LM Studio, Ollama, or any OpenAI-compatible server.
#   network_mode: host + LLM on this machine   → http://localhost:1234/v1
#   network_mode: host + LLM on another machine → http://<lan-ip>:1234/v1
#   bridge networking + LLM on the host         → http://host.docker.internal:1234/v1
LLM_BASE_URL=http://localhost:1234/v1

# --- Instance configuration ---

GENERIC_TIMEZONE=Europe/Warsaw
